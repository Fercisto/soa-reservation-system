PORT=3000
AUTH_SERVICE_URL=http://127.0.0.1:8000/api

# Shared with laravel-service: Nest sends it to Laravel's internal routes (X-Gateway-Secret).
GATEWAY_SECRET=

# Restaurant system (classmate): menu-service and employee-service.
# Each hotel saves its own API key in its settings (admin panel, tab "Mi plan").
RESTAURANT_MENU_URL=http://192.168.1.100:8083/api/v1/menu
RESTAURANT_EMPLOYEES_URL=http://192.168.1.100:8084/api/v1/employees
